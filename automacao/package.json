{
  "name": "verzel-store-qa-automacao",
  "version": "0.1.0",
  "private": true,
  "description": "Automação Playwright da entrega VZS-142 (cupom e frete grátis) da Verzel Store",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
