    {
      "key": "base",
      "value": "https://verzel-store.qa-test-verzel-store.workers.dev/api"
    }
  ],
  "item": [
    {
      "name": "CT-13 Produtos",
      "item": [
        {
          "name": "GET produtos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lista com 8 produtos (P001 a P008)\", () => { const j = pm.response.json(); pm.expect(j).to.have.lengthOf(8); pm.expect(j.map(p => p.id)).to.eql([\"P001\",\"P002\",\"P003\",\"P004\",\"P005\",\"P006\",\"P007\",\"P008\"]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base}}/produtos",
              "host": [
                "{{base}}"
              ],
              "path": [
                "produtos"
              ]
            }
          }
        },
