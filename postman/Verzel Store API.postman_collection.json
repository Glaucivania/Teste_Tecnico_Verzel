    {
      "name": "CT-14 Calcular com BEMVINDO10",
      "item": [
        {
          "name": "POST calcular BEMVINDO10 (exemplo da documentação)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"valores do exemplo da documentacao\", () => { const j = pm.response.json(); pm.expect(j.subtotal).to.eql(239.7); pm.expect(j.desconto).to.eql(23.97); pm.expect(j.frete).to.eql(0); pm.expect(j.freteGratis).to.eql(true); pm.expect(j.valorFaltanteFreteGratis).to.eql(0); pm.expect(j.total).to.eql(215.73); pm.expect(j.cupom.aplicado).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/carrinho/calcular",
              "host": [
                "{{base}}"
              ],
              "path": [
                "carrinho",
                "calcular"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itens\": [\n    {\n      \"produtoId\": \"P002\",\n      \"quantidade\": 1\n    },\n    {\n      \"produtoId\": \"P004\",\n      \"quantidade\": 2\n    }\n  ],\n  \"cupom\": \"BEMVINDO10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
